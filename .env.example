# =============================================================================
# API de Reservas DevOps - Exemplo de variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha a senha localmente:
#     cp .env.example .env
#
# O .env NÃO deve ser versionado (está no .gitignore). Este arquivo (.env.example)
# é versionado como documentação e NÃO contém senhas reais.
#
# O docker-compose usa estas variáveis para os serviços `api` e `db`.
# =============================================================================

# -----------------------------------------------------------------------------
# Conexão com o banco de dados PostgreSQL
# -----------------------------------------------------------------------------
# Opção A: connection string completa (tem precedência quando definida).
#   Formato: postgres://<usuario>:<senha>@<host>:<porta>/<banco>
#   Ex.: dentro do Compose o host é o nome do serviço do banco (db).
DATABASE_URL=postgres://reservas:CHANGE_ME@db:5432/reservas

# Opção B: variáveis discretas (usadas quando DATABASE_URL não está definida).
# PGHOST     -> Host do banco (no Compose, o nome do serviço, ex.: db)
# PGPORT     -> Porta do PostgreSQL
# PGUSER     -> Usuário do banco
# PGPASSWORD -> Senha do banco (deixe em branco aqui; preencha no .env local)
# PGDATABASE -> Nome do banco
PGHOST=db
PGPORT=5432
PGUSER=reservas
PGPASSWORD=
PGDATABASE=reservas

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# PORT -> Porta HTTP em que a API escuta (padrão 3000)
PORT=3000
